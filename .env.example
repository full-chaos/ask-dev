# Ask Dev Workbench — build-time configuration.
#
# Copy to `.env.local` (git-ignored) to override. Never commit real values, and
# never put a credential in any VITE_* variable: Vite inlines them into the
# public bundle.

# Base URL of the ACR Context Fabric investigation API. Left empty in the
# scaffold: the workbench answers from committed mock fixtures until the live
# wiring lands.
VITE_ASK_DEV_API_BASE_URL=

# Set to "false" only when VITE_ASK_DEV_API_BASE_URL points at a real service.
VITE_ASK_DEV_USE_MOCKS=true
