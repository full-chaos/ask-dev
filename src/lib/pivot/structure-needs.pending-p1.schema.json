{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://contracts.fullchaos.dev/ask-dev/pending/structure_needs.pending-p1.schema.json",
    "title": "PENDING-P1 staging copy of the StructureNeeds/ConfirmedStructure $defs",
    "description": "NOT a synced contract artifact (see src/lib/pivot/structure-contracts.ts header). Copied verbatim from acr branch chaos-pivot-p1's contracts/jsonschema/v1/context_fabric_common.v1.schema.json $defs, for validating THIS repo's own schema-derived fixtures only -- never a real ACR response. Deleted, not edited, once the ask-dev contract pin bumps past P1's acr merge.",
    "$defs": {
        "SubjectKind": {
            "type": "string",
            "enum": [
                "organization",
                "team",
                "project",
                "repository",
                "work_item",
                "pull_request",
                "deployment",
                "incident",
                "document",
                "decision",
                "episode",
                "metric",
                "pull_request_review",
                "ci_pipeline_run",
                "work_item_ref"
            ]
        },
        "RelativeWindowID": {
            "type": "string",
            "enum": ["trailing_30d", "trailing_90d", "trailing_365d", "all_time"]
        },
        "StructureNeedKind": {
            "type": "string",
            "enum": ["expected_kind", "subject_anchor", "subject_handle", "window"]
        },
        "StructureOfferSource": {
            "type": "string",
            "enum": ["engine", "prior"]
        },
        "StructureSource": {
            "type": "string",
            "enum": ["receipt", "explicit", "explicit_unattributed"]
        },
        "StructureProvenance": {
            "type": "string",
            "enum": ["inferred_default", "question_stated", "clarification_confirmed"]
        },
        "StructureDisposition": {
            "type": "string",
            "enum": ["applied", "vetoed_unresolved", "vetoed_conflict", "vetoed_stale"]
        },
        "KindOption": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "receipt_id": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 256,
                    "pattern": "^kindr_"
                },
                "option_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "kind": { "$ref": "#/$defs/SubjectKind" },
                "offer_source": { "$ref": "#/$defs/StructureOfferSource" },
                "prior_version_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "prior_entry_id": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "required": ["receipt_id", "option_id", "label", "kind", "offer_source"]
        },
        "AnchorOption": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "receipt_id": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 256,
                    "pattern": "^ancr_"
                },
                "option_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "kind": { "$ref": "#/$defs/SubjectKind" },
                "canonical_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "matched_term_hash": {
                    "description": "CONTRACT UPDATE (team-lead, post-P1.E): replaces the removed claimant_key. Opaque hex digest, never displayed. NOT YET landed on chaos-pivot-p1 as of this edit -- bound taken from the team-lead's description, re-verify once committed.",
                    "type": "string",
                    "pattern": "^[0-9a-f]+$",
                    "minLength": 1,
                    "maxLength": 256
                },
                "offer_source": { "$ref": "#/$defs/StructureOfferSource" },
                "prior_version_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "prior_entry_id": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "required": [
                "receipt_id",
                "option_id",
                "label",
                "kind",
                "canonical_id",
                "matched_term_hash",
                "offer_source"
            ]
        },
        "HandleOption": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "receipt_id": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 256,
                    "pattern": "^handr_"
                },
                "option_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "kind": { "$ref": "#/$defs/SubjectKind" },
                "pattern_id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "value": { "type": "string", "minLength": 1, "maxLength": 256 },
                "source_column": { "type": "string", "minLength": 1, "maxLength": 128 },
                "offer_source": { "$ref": "#/$defs/StructureOfferSource" },
                "prior_version_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "prior_entry_id": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "required": [
                "receipt_id",
                "option_id",
                "label",
                "kind",
                "pattern_id",
                "value",
                "source_column",
                "offer_source"
            ]
        },
        "WindowOption": {
            "description": "CHAOS-3900 W1: one server-offered window choice, minted onto a stored result so a later turn can confirm it via winr_ receipt redemption. Start/end are the FROZEN absolute bounds computed at offer time.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "receipt_id": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 256,
                    "pattern": "^winr_"
                },
                "option_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "relative_id": { "$ref": "#/$defs/RelativeWindowID" },
                "start": { "type": "string", "format": "date-time" },
                "end": { "type": "string", "format": "date-time" }
            },
            "required": ["receipt_id", "option_id", "label"],
            "allOf": [
                {
                    "description": "CHAOS-3900 W1: a non-all_time relative_id's bounds are the FROZEN offer-time computation, so both must be present.",
                    "if": {
                        "properties": { "relative_id": { "not": { "const": "all_time" } } },
                        "required": ["relative_id"]
                    },
                    "then": { "required": ["start", "end"] }
                },
                {
                    "description": "CHAOS-3900 W1 (codex round 7): all_time forbids any bound. Deliberately does NOT also fire when relative_id is absent: an option with no relative_id and BOTH bounds present is a legal explicit-bounds-only shape.",
                    "if": {
                        "properties": { "relative_id": { "const": "all_time" } },
                        "required": ["relative_id"]
                    },
                    "then": {
                        "not": { "anyOf": [{ "required": ["start"] }, { "required": ["end"] }] }
                    }
                }
            ],
            "anyOf": [{ "required": ["relative_id"] }, { "required": ["start", "end"] }],
            "not": {
                "description": "CHAOS-3900 W1 (codex round 7): completeness guard -- forbids exactly-one-of-start/end unconditionally.",
                "anyOf": [
                    { "required": ["start"], "not": { "required": ["end"] } },
                    { "required": ["end"], "not": { "required": ["start"] } }
                ]
            }
        },
        "WindowClarification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "options": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/WindowOption" },
                    "minItems": 1,
                    "maxItems": 20,
                    "uniqueItems": true
                }
            },
            "required": ["options"]
        },
        "AcceptedGrammar": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "member": { "$ref": "#/$defs/StructureNeedKind" },
                "kind": { "$ref": "#/$defs/SubjectKind" },
                "pattern_id": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "required": ["member", "pattern_id"]
        },
        "StructureNeeds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "missing": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/StructureNeedKind" },
                    "minItems": 1,
                    "maxItems": 4,
                    "uniqueItems": true
                },
                "kind_options": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/KindOption" },
                    "maxItems": 20
                },
                "anchor_options": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/AnchorOption" },
                    "maxItems": 20
                },
                "handle_options": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/HandleOption" },
                    "maxItems": 20
                },
                "window_options": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/WindowOption" },
                    "maxItems": 20
                },
                "accepted_grammars": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/AcceptedGrammar" },
                    "maxItems": 20
                }
            },
            "required": ["missing"]
        },
        "ConfirmedStructureEntry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "member": { "$ref": "#/$defs/StructureNeedKind" },
                "applied_value": { "type": "string", "minLength": 1, "maxLength": 256 },
                "source": { "$ref": "#/$defs/StructureSource" },
                "prior_result_id": { "type": "string", "minLength": 8, "maxLength": 256 },
                "receipt_id": { "type": "string", "minLength": 8, "maxLength": 256 },
                "offer_source": { "$ref": "#/$defs/StructureOfferSource" },
                "prior_version_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "prior_entry_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "provenance": { "$ref": "#/$defs/StructureProvenance" },
                "disposition": { "$ref": "#/$defs/StructureDisposition" }
            },
            "required": ["member", "applied_value", "source", "provenance", "disposition"],
            "if": {
                "properties": { "source": { "const": "receipt" } },
                "required": ["source"]
            },
            "then": { "required": ["prior_result_id", "receipt_id"] },
            "else": {
                "not": {
                    "anyOf": [{ "required": ["prior_result_id"] }, { "required": ["receipt_id"] }]
                }
            }
        },
        "StructureOfferSnapshotEntry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "member": { "$ref": "#/$defs/StructureNeedKind" },
                "offer_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "rank": { "type": "integer", "minimum": 0 },
                "offer_source": { "$ref": "#/$defs/StructureOfferSource" },
                "prior_version_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "prior_entry_id": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "required": ["member", "offer_id", "rank", "offer_source"]
        },
        "BoundStructureReceipt": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "result_id": { "type": "string", "minLength": 8, "maxLength": 256 },
                "receipt_id": { "type": "string", "minLength": 8, "maxLength": 256 }
            },
            "required": ["result_id", "receipt_id"]
        },
        "StructureAwareResultFragment": {
            "description": "The four additive fields this staging schema validates on a fixture. Not the whole InvestigationResult -- fixtures spread these onto a real, pinned-schema-valid canonical example and this fragment validates only the new part.",
            "type": "object",
            "properties": {
                "structure_needs": { "$ref": "#/$defs/StructureNeeds" },
                "confirmed_structure": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/ConfirmedStructureEntry" },
                    "maxItems": 4
                },
                "structure_offer_snapshot": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/StructureOfferSnapshotEntry" },
                    "maxItems": 80
                },
                "window_clarification": { "$ref": "#/$defs/WindowClarification" }
            }
        }
    }
}
